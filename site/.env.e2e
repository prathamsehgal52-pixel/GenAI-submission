# Browser end-to-end tests. Real Postgres, real S3-compatible storage and a
# real background worker; only the AI and product sources use the explicit
# test fixtures (permitted only with APP_ENV=test).
APP_ENV=test
PORT=8788
APP_URL=http://localhost:5174
DATABASE_URL=postgres://armoire:armoire@localhost:5433/armoire_e2e
AUTH_SECRET=e2e-secret-e2e-secret-e2e-secret-0123456789
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=armoire-e2e
S3_ACCESS_KEY_ID=armoire
S3_SECRET_ACCESS_KEY=armoire-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
AI_PROVIDER=fixture
PRODUCT_PROVIDERS=fixture
EMAIL_DRIVER=memory
WEATHER_ENABLED=false
MIGRATE_ON_START=true
LOG_LEVEL=warn
