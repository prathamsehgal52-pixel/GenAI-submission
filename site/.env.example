# ─────────────────────────────────────────────────────────────────────────────
# Armoire configuration. Copy to `.env` for local development.
# Every variable is validated at startup; the process exits with a clear
# message if something required is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
# Port the API (and, in production, the web app) listens on.
PORT=8787
# Public origin of the web app. Used for auth callbacks, email links, CORS/CSRF
# origin checks. Must be https in production.
APP_URL=http://localhost:5173
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Set to true when running behind a reverse proxy/load balancer so client IPs
# are read from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string.
DATABASE_URL=postgres://armoire:armoire@localhost:5433/armoire
DATABASE_POOL_MAX=10

# ── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign sessions and tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated emails allowed to open the operator status page (/app/admin).
ADMIN_EMAILS=

# ── Object storage (private, S3-compatible) ─────────────────────────────────
# Photos are stored privately and served through short-lived signed URLs.
STORAGE_DRIVER=s3
# Leave empty for AWS S3. Set for R2/SeaweedFS/other S3-compatible services.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=armoire-media
S3_ACCESS_KEY_ID=armoire
S3_SECRET_ACCESS_KEY=armoire-secret
# true for SeaweedFS/most self-hosted services; false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if it does not exist (development convenience).
S3_AUTO_CREATE_BUCKET=true
# Lifetime of signed image URLs.
SIGNED_URL_TTL_SECONDS=3600

# ── AI (garment recognition and outfit explanations) ────────────────────────
# anthropic | gemini | none. With `none` (or no key for the selected
# provider), uploads still work and users add garment details themselves;
# styling uses the rules engine without AI commentary.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only used when AI_PROVIDER=gemini. Free, no billing setup: create one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# claude-opus-5-5 (Anthropic) or gemini-flash-latest / gemini-flash-lite-latest (Gemini, free tier)
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000
# Maximum AI calls per user per day (cost protection).
AI_DAILY_USER_LIMIT=200

# ── Product discovery sources ───────────────────────────────────────────────
# Comma-separated: ebay, feed
PRODUCT_PROVIDERS=ebay
# eBay Browse API (https://developer.ebay.com). Production keyset, OAuth client
# credentials grant. Listings link to eBay item pages with eBay attribution.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENVIRONMENT=production
# Optional eBay Partner Network campaign id for affiliate links.
EBAY_AFFILIATE_CAMPAIGN_ID=
# Authorized affiliate product feeds (e.g. Awin). Comma-separated https URLs.
PRODUCT_FEED_URLS=
# awin_csv | json
PRODUCT_FEED_FORMAT=awin_csv
# Hosts that feed product links may point to (comma-separated). Links to any
# other host are rejected.
PRODUCT_FEED_ALLOWED_LINK_HOSTS=
# Cron schedule (UTC) for the background discovery refresh.
DISCOVERY_CRON=0 6 * * *
DISCOVERY_MAX_QUERIES_PER_USER=6

# ── Weather (Open-Meteo, no key required) ───────────────────────────────────
WEATHER_ENABLED=true

# ── Email (password reset, discovery digests) ───────────────────────────────
# smtp | none. Production requires smtp.
EMAIL_DRIVER=smtp
# e.g. smtps://user:pass@smtp.provider.com:465 (local: smtp://localhost:1025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Armoire <hello@armoire.app>

# ── Error monitoring (optional) ─────────────────────────────────────────────
# Requires `npm i @sentry/node` in the deployed image.
SENTRY_DSN=
