# Automated test environment. Test-only adapters (memory storage, fixture AI
# and product providers, in-memory email, inline jobs) are permitted ONLY when
# APP_ENV=test — the config refuses them anywhere else.
APP_ENV=test
APP_URL=http://localhost:5173
DATABASE_URL=postgres://armoire:armoire@localhost:5433/armoire_test
AUTH_SECRET=test-secret-test-secret-test-secret-0123456789
ADMIN_EMAILS=admin@example.com
STORAGE_DRIVER=memory
AI_PROVIDER=fixture
PRODUCT_PROVIDERS=fixture
EMAIL_DRIVER=memory
WEATHER_ENABLED=false
JOBS_INLINE=true
LOG_LEVEL=warn
