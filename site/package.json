{
  "name": "armoire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c magenta,cyan,yellow \"vite\" \"tsx watch --env-file=.env server/index.ts\" \"tsx watch --env-file=.env server/worker.ts\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && npm run build:server",
    "build:server": "rm -rf dist-server && esbuild server/index.ts server/worker.ts server/db/migrate-cli.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist-server --packages=external --sourcemap && rm -rf dist-server/migrations dist-server/db/migrations && cp -R server/db/migrations dist-server/migrations && cp -R server/db/migrations dist-server/db/migrations",
    "build:api": "rm -rf api && esbuild server/vercel-entry.ts --bundle --platform=node --target=node22 --format=esm --outfile=api/index.js --packages=external",
    "start": "node --enable-source-maps dist-server/index.js",
    "worker": "node --enable-source-maps dist-server/worker.js",
    "db:migrate": "tsx --env-file=.env server/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "db:migrate:prod": "node dist-server/db/migrate-cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "@hono/vercel": "^1.0.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
