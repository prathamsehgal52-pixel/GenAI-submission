{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
